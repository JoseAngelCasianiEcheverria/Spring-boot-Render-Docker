# =============================================
# Plantilla de variables de entorno
# =============================================
# Copia este archivo como ".env" y rellena los valores:
#   copy .env.example .env
#
# El archivo .env esta en .gitignore y NO debe subirse al repositorio.
# =============================================

# ── Base de datos ─────────────────────────────────────────────────────────
# Contraseña del usuario de aplicación (NO root). Se usa tanto para el
# contenedor MySQL como para la API.
DB_PASSWORD=cambia_esta_contrasena_de_app

# Contraseña del usuario root del MySQL local.
DB_ROOT_PASSWORD=cambia_esta_contrasena_de_root

# ── JWT ───────────────────────────────────────────────────────────────────
# OBLIGATORIA. Minimo 32 bytes en Base64. Genera una con:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
# Sin esta variable la aplicación NO arranca (a proposito).
JWT_SECRET=

# ── SMTP (opcional en local) ──────────────────────────────────────────────
# Sin esto la API arranca, pero el envio de correo fallara al autenticar
# contra el servidor SMTP. Es el adaptador por defecto (perfil !brevo).
# Desde Render NO envia: el plan gratuito bloquea los puertos 25, 465 y 587.
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# ── Otros ─────────────────────────────────────────────────────────────────
JWT_EXPIRATION_SECONDS=900
SMTP_FROM_NAME=Gestion de Usuarios

# ── Brevo por API REST (para produccion) ──────────────────────────────────
# Necesario con SPRING_PROFILES_ACTIVE=brevo, que es lo que corre en Render.
# Es el unico canal que envia desde alli: viaja por HTTPS en el 443, no por SMTP.
#
# OJO: BREVO_API_KEY es la clave xkeysib-..., NO la xsmtpsib-... del relay.
# Son credenciales distintas y cada una solo sirve para su canal.
#
#   BREVO_API_KEY=xkeysib-REEMPLAZAR
#   BREVO_FROM_ADDRESS=remitente-verificado@example.com
BREVO_API_KEY=
BREVO_FROM_ADDRESS=
BREVO_FROM_NAME=Gestion de Usuarios

# ── TiDB Cloud (opcional) ────────────────────────────────────────────────
# NO las usa docker compose: compose.yaml fija DB_HOST=mysql y
# DB_SSL_MODE=DISABLED a proposito. Son para correr la API contra el cluster
# de TiDB desde tu maquina, o para documentar lo que Render necesita.
#
# TiDB Cloud Starter solo acepta conexiones con TLS, asi que DB_SSL_MODE no es
# opcional ahi. El certificado lo emite Let's Encrypt, que ya esta en el
# cacerts del JDK: VERIFY_IDENTITY verifica sin instalar nada.
#
#   DB_HOST=gateway-xxxxxx.us-east-1.aws.tidbcloud.com
#   DB_PORT=4000
#   DB_NAME=crud_usuarios
#   DB_USERNAME=1234567890123.root      # incluye el sufijo ".root"
#   DB_PASSWORD=<la que generaste en TiDB Connect>
#   DB_SSL_MODE=VERIFY_IDENTITY